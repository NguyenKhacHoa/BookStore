<div class="max-w-3xl">
  <div class="mb-5">
    <a href="/admin/books" class="text-sm font-semibold text-indigo-600 hover:underline">&larr; Quay lại danh sách sách</a>
  </div>

  <form
    action="<%= formAction %>"
    method="POST"
    enctype="multipart/form-data"
    class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm space-y-5"
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      <div class="sm:col-span-2">
        <label for="title" class="block text-sm font-semibold text-slate-700 mb-1.5">Tên sách <span class="text-rose-500">*</span></label>
        <input
          id="title"
          type="text"
          name="title"
          required
          value="<%= book ? book.title : '' %>"
          placeholder="Nhập tên cuốn sách"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div>
        <label for="author" class="block text-sm font-semibold text-slate-700 mb-1.5">Tác giả <span class="text-rose-500">*</span></label>
        <input
          id="author"
          type="text"
          name="author"
          required
          value="<%= book ? book.author : '' %>"
          placeholder="Nhập tên tác giả"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div>
        <label for="category_id" class="block text-sm font-semibold text-slate-700 mb-1.5">Danh mục <span class="text-rose-500">*</span></label>
        <select
          id="category_id"
          name="category_id"
          required
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 outline-none bg-white"
        >
          <option value="">-- Chọn danh mục --</option>
          <% categories.forEach((cat) => { %>
            <option value="<%= cat.id %>" <%= book && book.category_id === cat.id ? 'selected' : '' %>>
              <%= cat.name %>
            </option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="price" class="block text-sm font-semibold text-slate-700 mb-1.5">Giá bán (VNĐ) <span class="text-rose-500">*</span></label>
        <input
          id="price"
          type="number"
          name="price"
          min="0"
          step="1000"
          required
          value="<%= book ? book.price : 100000 %>"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 outline-none"
        />
      </div>

      <div>
        <label for="stock" class="block text-sm font-semibold text-slate-700 mb-1.5">Số lượng tồn kho <span class="text-rose-500">*</span></label>
        <input
          id="stock"
          type="number"
          name="stock"
          min="0"
          required
          value="<%= book ? book.stock : 10 %>"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 outline-none"
        />
      </div>

      <div class="sm:col-span-2">
        <label for="is_active" class="block text-sm font-semibold text-slate-700 mb-1.5">Trạng thái hiển thị</label>
        <select
          id="is_active"
          name="is_active"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl bg-white outline-none"
        >
          <option value="1" <%= !book || book.is_active === 1 ? 'selected' : '' %>>Đang bán (Hiển thị)</option>
          <option value="0" <%= book && book.is_active === 0 ? 'selected' : '' %>>Ngừng kinh doanh (Ẩn)</option>
        </select>
      </div>

      <div class="sm:col-span-2">
        <label for="cover_image" class="block text-sm font-semibold text-slate-700 mb-1.5">Ảnh bìa sách (Upload JPG/PNG/WEBP)</label>
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <img
            id="coverPreview"
            src="<%= book ? book.cover_image : '/images/default-book.png' %>"
            alt="Cover preview"
            class="w-24 h-32 rounded-xl object-cover border border-slate-200 bg-slate-100 shrink-0"
          />
          <div class="flex-1">
            <input
              id="cover_image"
              type="file"
              name="cover_image"
              accept="image/*"
              onchange="if(this.files && this.files[0]) document.getElementById('coverPreview').src = URL.createObjectURL(this.files[0])"
              class="block w-full text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100"
            />
            <p class="text-xs text-slate-400 mt-2">
              Tối đa 5MB. Để trống nếu muốn giữ nguyên ảnh hiện tại.
            </p>
          </div>
        </div>
      </div>

      <div class="sm:col-span-2">
        <label for="description" class="block text-sm font-semibold text-slate-700 mb-1.5">Mô tả nội dung</label>
        <textarea
          id="description"
          name="description"
          rows="4"
          placeholder="Tóm tắt nội dung cuốn sách..."
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        ><%= book && book.description ? book.description : '' %></textarea>
      </div>
    </div>

    <div class="pt-4 border-t border-slate-200 flex items-center gap-3">
      <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-bold hover:bg-indigo-700 shadow-sm transition">
        <%= book ? 'Lưu thay đổi' : 'Thêm sách mới' %>
      </button>
      <a href="/admin/books" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-50 transition">
        Hủy
      </a>
    </div>
  </form>
</div>
