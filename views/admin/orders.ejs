<%
  const statusStyles = {
    PENDING: { label: 'Chờ xác nhận', cls: 'bg-amber-100 text-amber-800' },
    CONFIRMED: { label: 'Đã xác nhận', cls: 'bg-indigo-100 text-indigo-800' },
    SHIPPING: { label: 'Đang giao', cls: 'bg-sky-100 text-sky-800' },
    COMPLETED: { label: 'Hoàn thành', cls: 'bg-emerald-100 text-emerald-800' },
    CANCELLED: { label: 'Đã hủy', cls: 'bg-rose-100 text-rose-800' },
    RETURN_REQUESTED: { label: 'Yêu cầu hoàn hàng', cls: 'bg-orange-100 text-orange-800' },
    RETURNED: { label: 'Đã hoàn hàng', cls: 'bg-purple-100 text-purple-800' },
    RETURN_REJECTED: { label: 'Từ chối hoàn hàng', cls: 'bg-slate-200 text-slate-700' },
  };
  const tabs = [
    { key: '', label: 'Tất cả' },
    { key: 'PENDING', label: 'Chờ xác nhận' },
    { key: 'CONFIRMED', label: 'Đã xác nhận' },
    { key: 'SHIPPING', label: 'Đang giao' },
    { key: 'COMPLETED', label: 'Hoàn thành' },
    { key: 'RETURN_REQUESTED', label: 'Yêu cầu hoàn hàng' },
    { key: 'RETURNED', label: 'Đã hoàn hàng' },
    { key: 'RETURN_REJECTED', label: 'Từ chối hoàn hàng' },
    { key: 'CANCELLED', label: 'Đã hủy' },
  ];
%>

<!-- Filter Tabs -->
<div class="flex flex-wrap items-center gap-2 mb-6">
  <% tabs.forEach((tab) => { %>
    <a
      href="/admin/orders<%= tab.key ? '?status=' + tab.key : '' %>"
      class="px-4 py-2 rounded-xl text-xs font-bold border transition <%= (currentStatus || '') === tab.key ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-600 border-slate-200 hover:border-indigo-300' %>"
    >
      <%= tab.label %>
    </a>
  <% }) %>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-sm text-left">
      <thead class="bg-slate-50 text-xs text-slate-500 uppercase border-b border-slate-200">
        <tr>
          <th class="px-5 py-3.5">Mã đơn</th>
          <th class="px-5 py-3.5">Khách hàng</th>
          <th class="px-5 py-3.5">Tổng tiền</th>
          <th class="px-5 py-3.5">Thanh toán</th>
          <th class="px-5 py-3.5">Trạng thái đơn</th>
          <th class="px-5 py-3.5 text-right">Duyệt nhanh &amp; Chi tiết</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (orders.length === 0) { %>
          <tr>
            <td colspan="6" class="px-5 py-10 text-center text-slate-500">Không có đơn hàng nào.</td>
          </tr>
        <% } %>
        <% orders.forEach((order) => {
          const badge = statusStyles[order.status] || { label: order.status, cls: 'bg-slate-100 text-slate-700' };
          const pStatus = order.payment_status || 'UNPAID';
          const isPaid = pStatus === 'PAID';
          const isRefunded = pStatus === 'REFUNDED';
          const paymentBadgeCls = isPaid
            ? 'bg-emerald-100 text-emerald-800'
            : isRefunded
              ? 'bg-purple-100 text-purple-800'
              : 'bg-amber-50 text-amber-700 border border-amber-200';
          const paymentBadgeLabel = isPaid
            ? 'Đã thanh toán'
            : isRefunded
              ? 'Đã hoàn tiền (VIETQR)'
              : 'Chưa thanh toán';
        %>
          <tr class="<%= order.status === 'RETURN_REQUESTED' ? 'bg-orange-50/70 hover:bg-orange-50' : 'hover:bg-slate-50' %>">
            <td class="px-5 py-3.5">
              <div class="font-extrabold text-slate-900">#<%= order.id %></div>
              <div class="text-[11px] text-slate-400"><%= new Date(order.created_at).toLocaleString('vi-VN') %></div>
            </td>
            <td class="px-5 py-3.5">
              <div class="font-semibold text-slate-900"><%= order.user_name %></div>
              <div class="text-xs text-slate-500"><%= order.user_email %></div>
              <% if (order.return_reason) { %>
                <div class="mt-1 text-xs text-orange-800 bg-orange-100/80 px-2 py-1 rounded-lg max-w-xs">
                  <strong>Lý do hoàn:</strong> <%= order.return_reason %>
                </div>
              <% } %>
            </td>
            <td class="px-5 py-3.5">
              <div class="font-bold text-indigo-600"><%= formatCurrency(order.total_amount) %></div>
              <div class="text-xs text-slate-500"><%= order.item_count %> loại sách</div>
            </td>
            <td class="px-5 py-3.5">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold inline-block <%= paymentBadgeCls %>">
                <%= paymentBadgeLabel %>
              </span>
              <div class="text-[11px] text-slate-500 mt-1 font-semibold">
                <%= order.payment_method %><%= order.transaction_code ? ' • ' + order.transaction_code : '' %>
              </div>
            </td>
            <td class="px-5 py-3.5">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= badge.cls %>"><%= badge.label %></span>
            </td>
            <td class="px-5 py-3.5 text-right">
              <div class="inline-flex items-center gap-2">
                <% if (order.status === 'PENDING') { %>
                  <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline">
                    <input type="hidden" name="status" value="CONFIRMED" />
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold hover:bg-emerald-700 transition">
                      Duyệt đơn
                    </button>
                  </form>
                <% } else if (order.status === 'CONFIRMED') { %>
                  <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline">
                    <input type="hidden" name="status" value="SHIPPING" />
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-sky-600 text-white text-xs font-bold hover:bg-sky-700 transition">
                      Giao hàng
                    </button>
                  </form>
                <% } else if (order.status === 'SHIPPING') { %>
                  <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline">
                    <input type="hidden" name="status" value="COMPLETED" />
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700 transition">
                      Hoàn thành
                    </button>
                  </form>
                <% } else if (order.status === 'RETURN_REQUESTED') { %>
                  <form action="/admin/orders/<%= order.id %>/approve-return" method="POST" class="inline" onsubmit="return confirm('Chấp nhận hoàn hàng, hoàn tiền (REFUNDED) và cộng lại tồn kho cho đơn #<%= order.id %>?')">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-purple-600 text-white text-xs font-bold hover:bg-purple-700 transition">
                      Chấp nhận hoàn hàng
                    </button>
                  </form>
                  <form action="/admin/orders/<%= order.id %>/reject-return" method="POST" class="inline" onsubmit="return confirm('Từ chối yêu cầu hoàn hàng của đơn #<%= order.id %>?')">
                    <button type="submit" class="px-3 py-1.5 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 text-xs font-bold hover:bg-rose-600 hover:text-white transition">
                      Từ chối hoàn hàng
                    </button>
                  </form>
                <% } %>

                <a href="/admin/orders/<%= order.id %>" class="px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-semibold hover:bg-indigo-100 transition">
                  Chi tiết &rarr;
                </a>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
