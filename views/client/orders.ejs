<%
  const statusStyles = {
    PENDING: { label: 'Chờ xác nhận', cls: 'bg-amber-100 text-amber-800' },
    SHIPPING: { label: 'Đang giao hàng', cls: 'bg-sky-100 text-sky-800' },
    COMPLETED: { label: 'Hoàn thành', cls: 'bg-emerald-100 text-emerald-800' },
    CANCELLED: { label: 'Đã hủy', cls: 'bg-rose-100 text-rose-800' },
  };
%>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">Lịch sử đơn hàng</h1>
      <p class="text-sm text-slate-500 mt-1">Theo dõi trạng thái đơn hàng bạn đã đặt</p>
    </div>
    <a href="/books" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
      Mua thêm sách
    </a>
  </div>

  <% if (orders.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-3xl p-12 text-center">
      <p class="text-slate-500">Bạn chưa có đơn hàng nào.</p>
      <a href="/books" class="inline-block mt-4 px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
        Khám phá tủ sách
      </a>
    </div>
  <% } else { %>
    <div class="space-y-5">
      <% orders.forEach((order) => {
        const badge = statusStyles[order.status] || { label: order.status, cls: 'bg-slate-100 text-slate-700' };
      %>
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
          <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-3">
              <span class="font-extrabold text-slate-900">Đơn hàng #<%= order.id %></span>
              <span class="text-xs text-slate-500"><%= order.created_at %></span>
              <span class="px-3 py-1 rounded-full text-xs font-bold <%= badge.cls %>">
                <%= badge.label %>
              </span>
            </div>

            <div class="flex items-center gap-3">
              <span class="text-base font-extrabold text-indigo-600">
                <%= formatCurrency(order.total_amount) %>
              </span>
              <% if (order.status === 'PENDING') { %>
                <form
                  action="/orders/<%= order.id %>/cancel"
                  method="POST"
                  onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng #<%= order.id %>?')"
                >
                  <button
                    type="submit"
                    class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-rose-600 border border-rose-200 bg-rose-50 hover:bg-rose-600 hover:text-white transition"
                  >
                    Hủy đơn
                  </button>
                </form>
              <% } %>
            </div>
          </div>

          <div class="p-6">
            <div class="text-xs text-slate-500 mb-4 flex flex-wrap gap-x-6 gap-y-1">
              <span><strong class="text-slate-700">Địa chỉ:</strong> <%= order.shipping_address %></span>
              <span><strong class="text-slate-700">SĐT:</strong> <%= order.phone %></span>
              <span><strong class="text-slate-700">Thanh toán:</strong> <%= order.payment_method %></span>
            </div>

            <div class="divide-y divide-slate-100">
              <% (order.items || []).forEach((item) => { %>
                <div class="py-3 flex items-center gap-4">
                  <img
                    src="<%= item.book_cover || '/images/default-book.png' %>"
                    alt="<%= item.book_title %>"
                    class="w-12 h-16 rounded-lg object-cover border border-slate-200 shrink-0"
                  />
                  <div class="flex-1 min-w-0">
                    <a href="/books/<%= item.book_id %>" class="font-semibold text-sm text-slate-900 hover:text-indigo-600">
                      <%= item.book_title %>
                    </a>
                    <div class="text-xs text-slate-500">
                      Số lượng: <%= item.quantity %> &times; <%= formatCurrency(item.unit_price) %>
                    </div>
                  </div>
                  <div class="text-sm font-bold text-slate-800">
                    <%= formatCurrency(item.unit_price * item.quantity) %>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
