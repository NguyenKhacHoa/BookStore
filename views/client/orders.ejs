<%
  const statusStyles = {
    PENDING: { label: 'Chờ xác nhận', cls: 'bg-amber-100 text-amber-800', step: 1 },
    CONFIRMED: { label: 'Đã xác nhận', cls: 'bg-indigo-100 text-indigo-800', step: 2 },
    SHIPPING: { label: 'Đang giao hàng', cls: 'bg-sky-100 text-sky-800', step: 3 },
    COMPLETED: { label: 'Hoàn thành', cls: 'bg-emerald-100 text-emerald-800', step: 4 },
    CANCELLED: { label: 'Đã hủy', cls: 'bg-rose-100 text-rose-800', step: 0 },
    RETURN_REQUESTED: { label: 'Yêu cầu hoàn hàng', cls: 'bg-orange-100 text-orange-800', step: 4 },
    RETURNED: { label: 'Đã hoàn hàng', cls: 'bg-purple-100 text-purple-800', step: 0 },
    RETURN_REJECTED: { label: 'Từ chối hoàn hàng', cls: 'bg-slate-200 text-slate-700', step: 4 },
  };
  const stepLabels = ['Chờ xác nhận', 'Đã xác nhận', 'Đang giao', 'Hoàn thành'];
%>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">Đơn hàng của tôi</h1>
      <p class="text-sm text-slate-500 mt-1">Theo dõi trạng thái thanh toán và tiến trình giao hàng trực tiếp</p>
    </div>
    <a href="/books" class="px-4 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 shadow-sm transition">
      Mua thêm sách
    </a>
  </div>

  <% if (orders.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-3xl p-12 text-center">
      <p class="text-slate-500">Bạn chưa có đơn hàng nào.</p>
      <a href="/books" class="inline-block mt-4 px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
        Khám phá tủ sách
      </a>
    </div>
  <% } else { %>
    <div class="space-y-5">
      <% orders.forEach((order) => {
        const badge = statusStyles[order.status] || { label: order.status, cls: 'bg-slate-100 text-slate-700', step: 0 };
        const pStatus = order.payment_status || 'UNPAID';
        const isPaid = pStatus === 'PAID';
        const isRefunded = pStatus === 'REFUNDED';
        const paymentBadgeCls = isPaid
          ? 'bg-emerald-100 text-emerald-800'
          : isRefunded
            ? 'bg-purple-100 text-purple-800'
            : 'bg-amber-50 text-amber-700 border border-amber-200';
        const paymentBadgeLabel = isPaid
          ? `Đã thanh toán (${order.payment_method})`
          : isRefunded
            ? 'Đã hoàn tiền (VIETQR)'
            : `Chưa thanh toán (${order.payment_method})`;
      %>
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm hover:border-indigo-200 transition">
          <!-- Header -->
          <div class="px-6 py-4 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-3">
            <div class="flex flex-wrap items-center gap-2.5">
              <a href="/orders/<%= order.id %>" class="font-extrabold text-slate-900 hover:text-indigo-600 transition">
                Đơn hàng #<%= order.id %>
              </a>
              <span class="text-xs text-slate-500"><%= new Date(order.created_at).toLocaleString('vi-VN') %></span>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= badge.cls %>">
                <%= badge.label %>
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold <%= paymentBadgeCls %>">
                <%= paymentBadgeLabel %>
              </span>
            </div>

            <div class="text-base font-extrabold text-indigo-600">
              <%= formatCurrency(order.total_amount) %>
            </div>
          </div>

          <div class="p-6">
            <!-- Mini 4-step Progress Bar -->
            <% if (order.status !== 'CANCELLED') { %>
              <div class="mb-5 pb-5 border-b border-slate-100">
                <div class="grid grid-cols-4 gap-2">
                  <% stepLabels.forEach((lbl, idx) => {
                    const stepNum = idx + 1;
                    const reached = badge.step >= stepNum;
                  %>
                    <div class="flex flex-col items-center text-center">
                      <div class="w-full h-1.5 rounded-full mb-2 <%= reached ? 'bg-indigo-600' : 'bg-slate-200' %>"></div>
                      <span class="text-[11px] font-semibold <%= reached ? 'text-indigo-700' : 'text-slate-400' %>">
                        <%= lbl %>
                      </span>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Items -->
            <div class="divide-y divide-slate-100">
              <% (order.items || []).forEach((item) => { %>
                <div class="py-3 flex items-center gap-4">
                  <img
                    src="<%= item.book_cover || '/images/default-book.png' %>"
                    alt="<%= item.book_title %>"
                    class="w-12 h-16 rounded-lg object-cover border border-slate-200 shrink-0"
                  />
                  <div class="flex-1 min-w-0">
                    <a href="/books/<%= item.book_id %>" class="font-semibold text-sm text-slate-900 hover:text-indigo-600">
                      <%= item.book_title %>
                    </a>
                    <div class="text-xs text-slate-500">
                      Số lượng: <%= item.quantity %> &times; <%= formatCurrency(item.unit_price) %>
                    </div>
                  </div>
                  <div class="text-sm font-bold text-slate-800">
                    <%= formatCurrency(item.unit_price * item.quantity) %>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- Action Footer -->
            <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
              <div class="text-xs text-slate-500">
                <span><strong class="text-slate-700">Giao tới:</strong> <%= order.shipping_address %></span>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <% if (order.payment_method === 'VIETQR' && !isPaid && order.status !== 'CANCELLED') { %>
                  <a
                    href="/orders/<%= order.id %>/payment"
                    class="px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition"
                  >
                    Quét QR thanh toán ngay
                  </a>
                <% } %>

                <% if (order.status === 'SHIPPING') { %>
                  <form
                    action="/orders/<%= order.id %>/confirm-received"
                    method="POST"
                    onsubmit="return confirm('Xác nhận bạn đã nhận được đầy đủ sách của đơn hàng #<%= order.id %>?')"
                  >
                    <button
                      type="submit"
                      class="px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-sm transition"
                    >
                      ✓ Đã nhận được hàng
                    </button>
                  </form>
                <% } %>

                <% if (order.status === 'COMPLETED') { %>
                  <button
                    type="button"
                    onclick="openReturnModal(<%= order.id %>)"
                    class="px-3.5 py-2 rounded-xl border border-orange-300 bg-orange-50 text-orange-700 hover:bg-orange-600 hover:text-white text-xs font-bold transition"
                  >
                    Yêu cầu hoàn hàng
                  </button>
                <% } %>

                <% if (order.status === 'PENDING') { %>
                  <form
                    action="/orders/<%= order.id %>/cancel"
                    method="POST"
                    onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng #<%= order.id %>?')"
                  >
                    <button
                      type="submit"
                      class="px-3.5 py-2 rounded-xl text-xs font-semibold text-rose-600 border border-rose-200 bg-rose-50 hover:bg-rose-600 hover:text-white transition"
                    >
                      Hủy đơn hàng
                    </button>
                  </form>
                <% } %>

                <a
                  href="/orders/<%= order.id %>"
                  class="px-4 py-2 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-xs font-bold transition"
                >
                  Xem chi tiết &amp; Theo dõi &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Return Request Modal -->
<div id="returnModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-xl border border-slate-200">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-extrabold text-slate-900">Yêu cầu hoàn hàng <span id="returnOrderLabel" class="text-indigo-600"></span></h3>
      <button type="button" onclick="closeReturnModal()" class="text-slate-400 hover:text-slate-700 font-bold">✕</button>
    </div>
    <form id="returnForm" method="POST" class="space-y-4">
      <div>
        <label for="return_reason" class="block text-sm font-semibold text-slate-700 mb-1.5">Lý do hoàn hàng <span class="text-rose-500">*</span></label>
        <textarea
          id="return_reason"
          name="return_reason"
          rows="4"
          required
          placeholder="Mô tả tình trạng sách (rách bìa, sai sản phẩm, thiếu trang...)"
          class="w-full px-3.5 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        ></textarea>
      </div>
      <div class="flex items-center justify-end gap-2">
        <button type="button" onclick="closeReturnModal()" class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 text-sm font-semibold hover:bg-slate-50">
          Hủy
        </button>
        <button type="submit" class="px-5 py-2 rounded-xl bg-orange-600 hover:bg-orange-700 text-white text-sm font-bold shadow-sm transition">
          Gửi yêu cầu
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openReturnModal(orderId) {
    const modal = document.getElementById('returnModal');
    const form = document.getElementById('returnForm');
    const label = document.getElementById('returnOrderLabel');
    form.action = `/orders/${orderId}/request-return`;
    label.textContent = `#${orderId}`;
    document.getElementById('return_reason').value = '';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }
  function closeReturnModal() {
    const modal = document.getElementById('returnModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }
</script>
