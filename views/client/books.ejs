<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">Tủ sách Bookstore</h1>
      <p class="text-sm text-slate-500 mt-1">
        Hiển thị <span class="font-semibold text-slate-700"><%= pagination.total %></span> cuốn sách phù hợp
      </p>
    </div>

    <!-- Search & Sort Form -->
    <form action="/books" method="GET" class="flex flex-wrap items-center gap-2.5">
      <% if (filters.category) { %>
        <input type="hidden" name="category" value="<%= filters.category %>" />
      <% } %>
      <input
        type="text"
        name="q"
        value="<%= filters.q || '' %>"
        placeholder="Tìm tên sách, tác giả..."
        class="px-3.5 py-2 text-sm bg-white border border-slate-200 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none w-56"
      />
      <select
        name="sort"
        onchange="this.form.submit()"
        class="px-3.5 py-2 text-sm bg-white border border-slate-200 rounded-xl focus:border-indigo-500 outline-none"
      >
        <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Mới nhất</option>
        <option value="price_asc" <%= filters.sort === 'price_asc' ? 'selected' : '' %>>Giá tăng dần</option>
        <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Giá giảm dần</option>
        <option value="title_asc" <%= filters.sort === 'title_asc' ? 'selected' : '' %>>Tên A - Z</option>
      </select>
      <button type="submit" class="px-4 py-2 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
        Lọc
      </button>
    </form>
  </div>

  <!-- Category Pills -->
  <div class="flex flex-wrap items-center gap-2 mb-8">
    <a
      href="/books<%= filters.q ? '?q=' + encodeURIComponent(filters.q) : '' %>"
      class="px-4 py-2 rounded-full text-xs font-semibold border transition <%= !filters.category ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-600 border-slate-200 hover:border-indigo-300' %>"
    >
      Tất cả
    </a>
    <% categories.forEach((cat) => { %>
      <a
        href="/books?category=<%= cat.slug %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %><%= filters.sort ? '&sort=' + filters.sort : '' %>"
        class="px-4 py-2 rounded-full text-xs font-semibold border transition <%= filters.category === cat.slug || String(filters.category) === String(cat.id) ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-600 border-slate-200 hover:border-indigo-300' %>"
      >
        <%= cat.name %> (<%= cat.book_count %>)
      </a>
    <% }) %>
  </div>

  <!-- Books Grid -->
  <% if (books.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center">
      <p class="text-slate-500 text-base">Không tìm thấy cuốn sách nào phù hợp với từ khóa/bộ lọc hiện tại.</p>
      <a href="/books" class="inline-block mt-4 px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-700 transition">
        Xem tất cả sách
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% books.forEach((book) => { %>
        <div class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-lg hover:-translate-y-0.5 transition flex flex-col">
          <a href="/books/<%= book.id %>" class="block bg-slate-100 aspect-[3/4] overflow-hidden relative">
            <img
              src="<%= book.cover_image %>"
              alt="<%= book.title %>"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
            />
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-white/90 text-[11px] font-semibold text-slate-700 shadow-sm">
              <%= book.category_name %>
            </span>
          </a>

          <div class="p-4 flex-1 flex flex-col">
            <a href="/books/<%= book.id %>" class="font-bold text-slate-900 hover:text-indigo-600 transition line-clamp-2">
              <%= book.title %>
            </a>
            <p class="text-xs text-slate-500 mt-1"><%= book.author %></p>

            <div class="mt-auto pt-4 flex items-center justify-between gap-2">
              <div>
                <div class="text-base font-extrabold text-indigo-600"><%= formatCurrency(book.price) %></div>
                <div class="text-[11px] <%= book.stock > 0 ? 'text-emerald-600' : 'text-rose-500' %>">
                  <%= book.stock > 0 ? `Còn ${book.stock} cuốn` : 'Hết hàng' %>
                </div>
              </div>

              <% if (currentUser && currentUser.role === 'admin') { %>
                <a
                  href="/admin/books/<%= book.id %>/edit"
                  class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-xs font-semibold text-amber-800 bg-amber-100 hover:bg-amber-200 transition shadow-sm"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                  Chỉnh sửa
                </a>
              <% } else { %>
                <form action="/cart/add" method="POST">
                  <input type="hidden" name="bookId" value="<%= book.id %>" />
                  <input type="hidden" name="quantity" value="1" />
                  <button
                    type="submit"
                    <%= book.stock <= 0 ? 'disabled' : '' %>
                    class="px-3 py-2 rounded-xl text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed transition"
                  >
                    + Giỏ
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <div class="mt-10 flex items-center justify-center gap-2">
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <a
            href="/books?page=<%= p %><%= filters.q ? '&q=' + encodeURIComponent(filters.q) : '' %><%= filters.category ? '&category=' + encodeURIComponent(filters.category) : '' %><%= filters.sort ? '&sort=' + filters.sort : '' %>"
            class="w-10 h-10 rounded-xl flex items-center justify-center text-sm font-semibold border transition <%= p === pagination.page ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-700 border-slate-200 hover:border-indigo-400' %>"
          >
            <%= p %>
          </a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
