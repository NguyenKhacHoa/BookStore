<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-extrabold text-slate-900">Xác nhận đặt hàng</h1>
    <p class="text-sm text-slate-500 mt-1">Điền thông tin giao hàng và chọn phương thức thanh toán phù hợp</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Checkout Form -->
    <form action="/checkout" method="POST" class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm space-y-5">
      <h2 class="text-lg font-bold text-slate-900 pb-3 border-b border-slate-200">Thông tin nhận hàng</h2>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Họ và tên người nhận</label>
        <input
          type="text"
          value="<%= user ? user.full_name : '' %>"
          disabled
          class="w-full px-4 py-2.5 text-sm bg-slate-100 border border-slate-200 rounded-xl text-slate-600"
        />
      </div>

      <div>
        <label for="phone" class="block text-sm font-semibold text-slate-700 mb-1.5">Số điện thoại liên hệ <span class="text-rose-500">*</span></label>
        <input
          id="phone"
          type="text"
          name="phone"
          required
          value="<%= user && user.phone ? user.phone : '' %>"
          placeholder="Ví dụ: 0901234567"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div>
        <label for="shipping_address" class="block text-sm font-semibold text-slate-700 mb-1.5">Địa chỉ giao hàng <span class="text-rose-500">*</span></label>
        <textarea
          id="shipping_address"
          name="shipping_address"
          rows="3"
          required
          placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..."
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        ><%= user && user.address ? user.address : '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-2.5">Phương thức thanh toán</label>
        <div class="space-y-3">
          <!-- COD -->
          <label class="payment-option flex items-start gap-3 p-4 rounded-xl border-2 border-indigo-500 bg-indigo-50/50 cursor-pointer transition">
            <input type="radio" name="payment_method" value="COD" checked class="mt-1 w-4 h-4 text-indigo-600" onchange="highlightPayment(this)" />
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-bold text-slate-900">Thanh toán khi nhận hàng (COD)</span>
                <span class="px-2 py-0.5 rounded-full bg-slate-200 text-slate-700 text-[11px] font-semibold">Tiền mặt</span>
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Kiểm tra sách trước khi thanh toán tiền mặt cho nhân viên giao hàng.</div>
            </div>
          </label>

          <!-- VIETQR -->
          <label class="payment-option flex items-start gap-3 p-4 rounded-xl border-2 border-slate-200 bg-white hover:border-indigo-300 cursor-pointer transition">
            <input type="radio" name="payment_method" value="VIETQR" class="mt-1 w-4 h-4 text-indigo-600" onchange="highlightPayment(this)" />
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <span class="text-sm font-bold text-slate-900">Chuyển khoản QR (VietQR)</span>
                <span class="px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[11px] font-bold">Xác nhận tức thì</span>
              </div>
              <div class="text-xs text-slate-500 mt-0.5">Quét mã VietQR động bằng ứng dụng ngân hàng (MB Bank / Napas 247), tự động điền số tiền &amp; nội dung.</div>
            </div>
          </label>
        </div>
      </div>

      <div class="pt-3 flex flex-wrap items-center gap-3">
        <button
          type="submit"
          class="flex-1 sm:flex-none px-8 py-3.5 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 shadow-md transition"
        >
          Xác nhận đặt hàng
        </button>
        <a href="/cart" class="px-5 py-3.5 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition">
          Quay lại giỏ hàng
        </a>
      </div>
    </form>

    <!-- Order Summary -->
    <div class="lg:col-span-5">
      <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm sticky top-24">
        <h2 class="text-lg font-bold text-slate-900 pb-3 border-b border-slate-200">
          Đơn hàng (<%= cartCount %> sản phẩm)
        </h2>

        <div class="divide-y divide-slate-100 max-h-96 overflow-y-auto my-2">
          <% cart.forEach((item) => { %>
            <div class="py-3 flex items-center gap-3">
              <img src="<%= item.cover_image %>" alt="<%= item.title %>" class="w-12 h-16 rounded-lg object-cover border border-slate-200 shrink-0" />
              <div class="flex-1 min-w-0">
                <div class="text-sm font-semibold text-slate-900 truncate"><%= item.title %></div>
                <div class="text-xs text-slate-500">SL: <%= item.quantity %> &times; <%= formatCurrency(item.price) %></div>
              </div>
              <div class="text-sm font-bold text-slate-900 shrink-0">
                <%= formatCurrency(item.price * item.quantity) %>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="border-t border-slate-200 pt-4 mt-3 space-y-2 text-sm">
          <div class="flex justify-between text-slate-600">
            <span>Phí vận chuyển</span>
            <span class="font-semibold text-emerald-600">Miễn phí</span>
          </div>
          <div class="flex justify-between text-lg font-extrabold text-slate-900 pt-2">
            <span>Tổng cộng</span>
            <span class="text-indigo-600"><%= formatCurrency(totalAmount) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function highlightPayment(radio) {
    document.querySelectorAll('.payment-option').forEach((el) => {
      el.classList.remove('border-indigo-500', 'bg-indigo-50/50');
      el.classList.add('border-slate-200', 'bg-white');
    });
    const active = radio.closest('.payment-option');
    if (active) {
      active.classList.remove('border-slate-200', 'bg-white');
      active.classList.add('border-indigo-500', 'bg-indigo-50/50');
    }
  }
</script>
