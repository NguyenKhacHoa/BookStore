<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <a href="/orders/<%= order.id %>" class="text-xs font-semibold text-indigo-600 hover:underline">&larr; Xem chi tiết đơn hàng #<%= order.id %></a>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Thanh toán chuyển khoản VietQR</h1>
      <p class="text-sm text-slate-500 mt-1">Quét mã QR bằng ứng dụng ngân hàng để thanh toán tự động cho đơn hàng #<%= order.id %></p>
    </div>
    <span id="pollingBadge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-bold">
      <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
      Đang chờ thanh toán...
    </span>
  </div>

  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <!-- QR Image -->
    <div class="md:col-span-5 flex flex-col items-center">
      <div class="p-3 bg-white border-2 border-indigo-100 rounded-2xl shadow-md">
        <img
          src="<%= qrUrl %>"
          alt="Mã VietQR đơn hàng #<%= order.id %>"
          class="w-64 sm:w-72 h-auto rounded-xl"
        />
      </div>
      <p class="text-xs text-slate-400 mt-3 text-center">
        Hỗ trợ tất cả ứng dụng ngân hàng tại Việt Nam (Napas 247)
      </p>
    </div>

    <!-- Transfer Details -->
    <div class="md:col-span-7 space-y-4">
      <div class="rounded-2xl bg-slate-50 border border-slate-200 p-5 space-y-3 text-sm">
        <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-200">
          <span class="text-slate-500">Ngân hàng</span>
          <span class="font-bold text-slate-900"><%= bankInfo.bankName %></span>
        </div>
        <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-200">
          <span class="text-slate-500">Số tài khoản</span>
          <div class="flex items-center gap-2">
            <span class="font-mono font-bold text-slate-900"><%= bankInfo.accountNo %></span>
            <button
              type="button"
              onclick="copyText('<%= bankInfo.accountNo %>', this)"
              class="px-2.5 py-1 rounded-lg bg-slate-200 hover:bg-slate-300 text-slate-700 text-xs font-semibold transition"
            >
              Copy
            </button>
          </div>
        </div>
        <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-200">
          <span class="text-slate-500">Chủ tài khoản</span>
          <span class="font-bold text-slate-900"><%= bankInfo.accountName %></span>
        </div>
        <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-slate-200">
          <span class="text-slate-500">Số tiền cần chuyển</span>
          <span class="text-lg font-extrabold text-indigo-600"><%= formatCurrency(order.total_amount) %></span>
        </div>
        <div class="flex items-center justify-between gap-2">
          <span class="text-slate-500">Nội dung chuyển khoản</span>
          <div class="flex items-center gap-2">
            <code class="px-2.5 py-1 rounded-lg bg-indigo-100 text-indigo-800 font-extrabold tracking-wide"><%= transactionCode %></code>
            <button
              type="button"
              onclick="copyText('<%= transactionCode %>', this)"
              class="px-2.5 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition"
            >
              Copy
            </button>
          </div>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-sky-50 border border-sky-200 text-xs text-sky-800 leading-relaxed">
        <strong>Lưu ý:</strong> Hệ thống tự động kiểm tra giao dịch mỗi <strong>3 giây</strong>. Sau khi ngân hàng xác nhận, trang sẽ tự động chuyển sang màn hình theo dõi đơn hàng.
      </div>

      <!-- Demo Webhook Simulation -->
      <div class="pt-2 space-y-2.5">
        <button
          id="demoPayBtn"
          type="button"
          onclick="simulateBankWebhook()"
          class="w-full py-3.5 px-5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Giả lập ngân hàng báo đã nhận tiền (Demo)
        </button>

        <a
          href="/orders/<%= order.id %>"
          class="block w-full text-center py-2.5 rounded-xl border border-slate-200 text-slate-600 hover:bg-slate-50 text-xs font-semibold transition"
        >
          Thanh toán sau — Về trang chi tiết đơn hàng
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const ORDER_ID = <%= order.id %>;
  const TRANSACTION_CODE = '<%= transactionCode %>';

  function copyText(text, btn) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        const original = btn.textContent;
        btn.textContent = 'Đã copy!';
        setTimeout(() => (btn.textContent = original), 1500);
      });
    }
  }

  async function checkPaymentStatus() {
    try {
      const res = await fetch(`/orders/${ORDER_ID}/payment-status`, {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) return;
      const data = await res.json();
      if (data.isPaid) {
        clearInterval(pollTimer);
        const badge = document.getElementById('pollingBadge');
        if (badge) {
          badge.className = 'inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold';
          badge.innerHTML = '✓ Đã nhận thanh toán! Đang chuyển trang...';
        }
        window.location.href = data.redirectUrl || `/orders/${ORDER_ID}`;
      }
    } catch (e) {
      // Bỏ qua lỗi mạng tạm thời, sẽ thử lại sau 3s
    }
  }

  async function simulateBankWebhook() {
    const btn = document.getElementById('demoPayBtn');
    btn.disabled = true;
    btn.textContent = 'Đang xử lý xác nhận từ ngân hàng...';

    try {
      const res = await fetch('/api/payment/webhook', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: ORDER_ID,
          transactionCode: TRANSACTION_CODE,
        }),
      });
      const data = await res.json();
      if (data.success) {
        clearInterval(pollTimer);
        window.location.href = data.redirectUrl || `/orders/${ORDER_ID}`;
      } else {
        alert(data.error || 'Không thể xác nhận thanh toán.');
        btn.disabled = false;
        btn.textContent = 'Giả lập ngân hàng báo đã nhận tiền (Demo)';
      }
    } catch (err) {
      alert('Lỗi kết nối đến server.');
      btn.disabled = false;
      btn.textContent = 'Giả lập ngân hàng báo đã nhận tiền (Demo)';
    }
  }

  const pollTimer = setInterval(checkPaymentStatus, 3000);
</script>
