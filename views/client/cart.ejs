<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900">Giỏ hàng của bạn</h1>
      <p class="text-sm text-slate-500 mt-1">Kiểm tra lại số lượng sách trước khi đặt hàng</p>
    </div>
    <% if (cart.length > 0) { %>
      <form action="/cart/clear" method="POST">
        <button type="submit" class="text-xs font-semibold text-rose-600 hover:text-rose-700 hover:underline">
          Xóa toàn bộ giỏ hàng
        </button>
      </form>
    <% } %>
  </div>

  <% if (cart.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-3xl p-14 text-center">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h2 class="text-lg font-bold text-slate-900">Giỏ hàng đang trống</h2>
      <p class="text-sm text-slate-500 mt-1">Hãy khám phá tủ sách và chọn những cuốn sách bạn yêu thích nhé.</p>
      <a href="/books" class="inline-block mt-6 px-6 py-3 rounded-xl bg-indigo-600 text-white text-sm font-bold hover:bg-indigo-700 transition">
        Tiếp tục mua sắm
      </a>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Cart Items -->
      <div class="lg:col-span-8 space-y-4">
        <% cart.forEach((item) => { %>
          <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center gap-4">
            <a href="/books/<%= item.bookId %>" class="w-20 h-28 rounded-xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200">
              <img src="<%= item.cover_image %>" alt="<%= item.title %>" class="w-full h-full object-cover" />
            </a>

            <div class="flex-1 min-w-0">
              <a href="/books/<%= item.bookId %>" class="font-bold text-slate-900 hover:text-indigo-600 transition">
                <%= item.title %>
              </a>
              <div class="text-sm font-semibold text-indigo-600 mt-1">
                <%= formatCurrency(item.price) %> / cuốn
              </div>
            </div>

            <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
              <form action="/cart/update" method="POST" class="flex items-center gap-2">
                <input type="hidden" name="bookId" value="<%= item.bookId %>" />
                <input
                  type="number"
                  name="quantity"
                  value="<%= item.quantity %>"
                  min="1"
                  class="w-16 px-2.5 py-1.5 text-center text-sm font-bold border border-slate-300 rounded-lg focus:border-indigo-500 outline-none"
                />
                <button type="submit" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-xs font-semibold text-slate-700 transition">
                  Cập nhật
                </button>
              </form>

              <div class="text-right min-w-[95px]">
                <div class="text-sm font-extrabold text-slate-900">
                  <%= formatCurrency(item.price * item.quantity) %>
                </div>
              </div>

              <form action="/cart/remove" method="POST">
                <input type="hidden" name="bookId" value="<%= item.bookId %>" />
                <button type="submit" class="p-2 rounded-lg text-rose-500 hover:bg-rose-50 transition" title="Xóa">
                  ✕
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Summary -->
      <div class="lg:col-span-4">
        <div class="bg-white border border-slate-200 rounded-2xl p-6 sticky top-24 shadow-sm">
          <h2 class="text-lg font-bold text-slate-900 pb-4 border-b border-slate-200">Tóm tắt đơn hàng</h2>
          <div class="space-y-3 py-4 text-sm">
            <div class="flex justify-between text-slate-600">
              <span>Tổng số lượng</span>
              <span class="font-semibold text-slate-900"><%= cartCount %> cuốn</span>
            </div>
            <div class="flex justify-between text-slate-600">
              <span>Phí vận chuyển</span>
              <span class="font-semibold text-emerald-600">Miễn phí</span>
            </div>
            <div class="flex justify-between text-base font-extrabold text-slate-900 pt-3 border-t border-slate-200">
              <span>Tổng thanh toán</span>
              <span class="text-indigo-600"><%= formatCurrency(totalAmount) %></span>
            </div>
          </div>

          <a
            href="/checkout"
            class="block w-full text-center py-3 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 shadow-md transition"
          >
            Tiến hành đặt hàng &rarr;
          </a>
          <a
            href="/books"
            class="block w-full text-center mt-3 py-2.5 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition"
          >
            Tiếp tục mua sắm
          </a>
        </div>
      </div>
    </div>
  <% } %>
</div>
