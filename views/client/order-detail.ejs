<%
  const statusStyles = {
    PENDING: { label: 'Chờ xác nhận', cls: 'bg-amber-100 text-amber-800', step: 1 },
    CONFIRMED: { label: 'Đã xác nhận', cls: 'bg-indigo-100 text-indigo-800', step: 2 },
    SHIPPING: { label: 'Đang giao hàng', cls: 'bg-sky-100 text-sky-800', step: 3 },
    COMPLETED: { label: 'Hoàn thành', cls: 'bg-emerald-100 text-emerald-800', step: 4 },
    CANCELLED: { label: 'Đã hủy', cls: 'bg-rose-100 text-rose-800', step: 0 },
  };
  const badge = statusStyles[order.status] || { label: order.status, cls: 'bg-slate-100 text-slate-700', step: 0 };
  const isPaid = order.payment_status === 'PAID';
  const steps = [
    { key: 'PENDING', title: 'Chờ xác nhận', desc: 'Đơn hàng đã được tiếp nhận' },
    { key: 'CONFIRMED', title: 'Đã xác nhận', desc: 'Cửa hàng đã duyệt & đóng gói' },
    { key: 'SHIPPING', title: 'Đang giao hàng', desc: 'Đơn vị vận chuyển đang giao' },
    { key: 'COMPLETED', title: 'Hoàn thành', desc: 'Giao hàng thành công' },
  ];
%>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <div>
      <a href="/orders" class="text-xs font-semibold text-indigo-600 hover:underline">&larr; Quay lại danh sách đơn hàng</a>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-1">Theo dõi đơn hàng #<%= order.id %></h1>
      <p class="text-xs text-slate-500 mt-1">Đặt lúc: <%= new Date(order.created_at).toLocaleString('vi-VN') %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold <%= badge.cls %>">
        <%= badge.label %>
      </span>
      <span class="px-3.5 py-1.5 rounded-full text-xs font-bold <%= isPaid ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-50 text-amber-700 border border-amber-200' %>">
        <%= isPaid ? 'Đã thanh toán' : 'Chưa thanh toán' %>
      </span>
    </div>
  </div>

  <!-- 4-Step Visual Stepper / Timeline -->
  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-8 shadow-sm mb-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-base font-bold text-slate-900">Tiến trình xử lý đơn hàng</h2>
      <% if (order.status !== 'COMPLETED' && order.status !== 'CANCELLED') { %>
        <span class="inline-flex items-center gap-1.5 text-xs text-indigo-600 font-semibold">
          <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
          Tự động đồng bộ với quản trị viên
        </span>
      <% } %>
    </div>

    <% if (order.status === 'CANCELLED') { %>
      <div class="rounded-2xl bg-rose-50 border border-rose-200 p-5 flex items-center gap-3 text-rose-800">
        <div class="w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center font-bold shrink-0">✕</div>
        <div>
          <div class="font-bold text-sm">Đơn hàng đã bị hủy</div>
          <div class="text-xs text-rose-600 mt-0.5">Toàn bộ số lượng sách trong đơn hàng này đã được hoàn lại vào kho.</div>
        </div>
      </div>
    <% } else { %>
      <div class="relative grid grid-cols-1 sm:grid-cols-4 gap-6">
        <% steps.forEach((st, idx) => {
          const stepNum = idx + 1;
          const isCompleted = badge.step > stepNum || (order.status === 'COMPLETED' && stepNum === 4);
          const isCurrent = badge.step === stepNum && order.status !== 'COMPLETED';
        %>
          <div class="relative flex sm:flex-col items-start sm:items-center gap-3 sm:text-center">
            <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-extrabold shrink-0 border-2 transition <%= isCompleted ? 'bg-emerald-600 border-emerald-600 text-white' : isCurrent ? 'bg-indigo-600 border-indigo-600 text-white ring-4 ring-indigo-100' : 'bg-white border-slate-300 text-slate-400' %>">
              <%= isCompleted ? '✓' : stepNum %>
            </div>
            <div>
              <div class="text-sm font-bold <%= isCompleted || isCurrent ? 'text-slate-900' : 'text-slate-400' %>">
                <%= st.title %>
              </div>
              <div class="text-xs text-slate-500 mt-0.5"><%= st.desc %></div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- Action Alerts -->
  <div class="flex flex-wrap items-center gap-3 mb-6">
    <% if (order.payment_method === 'VIETQR' && !isPaid && order.status !== 'CANCELLED') { %>
      <a
        href="/orders/<%= order.id %>/payment"
        class="px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md transition"
      >
        Quét QR thanh toán ngay &rarr;
      </a>
    <% } %>

    <% if (order.status === 'PENDING') { %>
      <form
        action="/orders/<%= order.id %>/cancel"
        method="POST"
        onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #<%= order.id %>?')"
      >
        <button
          type="submit"
          class="px-5 py-3 rounded-xl border border-rose-300 bg-rose-50 text-rose-700 hover:bg-rose-600 hover:text-white font-bold text-sm transition"
        >
          Hủy đơn hàng
        </button>
      </form>
    <% } %>
  </div>

  <!-- Order Details & Shipping Info -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <div class="lg:col-span-8 bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="px-6 py-4 border-b border-slate-200 font-bold text-slate-900">
        Sản phẩm đã đặt (<%= (order.items || []).length %>)
      </div>
      <div class="divide-y divide-slate-100">
        <% (order.items || []).forEach((item) => { %>
          <div class="px-6 py-4 flex items-center gap-4">
            <img
              src="<%= item.book_cover || '/images/default-book.png' %>"
              alt="<%= item.book_title %>"
              class="w-12 h-16 rounded-lg object-cover border border-slate-200 shrink-0"
            />
            <div class="flex-1 min-w-0">
              <a href="/books/<%= item.book_id %>" class="font-bold text-sm text-slate-900 hover:text-indigo-600">
                <%= item.book_title %>
              </a>
              <div class="text-xs text-slate-500"><%= item.book_author %></div>
              <div class="text-xs text-slate-600 mt-1">
                <%= formatCurrency(item.unit_price) %> &times; <%= item.quantity %>
              </div>
            </div>
            <div class="font-extrabold text-sm text-slate-900">
              <%= formatCurrency(item.unit_price * item.quantity) %>
            </div>
          </div>
        <% }) %>
      </div>
      <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
        <span class="font-bold text-slate-700">Tổng thanh toán</span>
        <span class="text-xl font-extrabold text-indigo-600"><%= formatCurrency(order.total_amount) %></span>
      </div>
    </div>

    <div class="lg:col-span-4 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm space-y-3 text-sm h-fit">
      <h3 class="font-bold text-slate-900 pb-2 border-b border-slate-200">Thông tin giao hàng &amp; thanh toán</h3>
      <div><span class="text-slate-500">Người nhận:</span> <strong class="text-slate-800"><%= order.user_name %></strong></div>
      <div><span class="text-slate-500">SĐT:</span> <strong class="text-slate-800"><%= order.phone %></strong></div>
      <div><span class="text-slate-500">Địa chỉ:</span> <span class="text-slate-800"><%= order.shipping_address %></span></div>
      <div><span class="text-slate-500">Phương thức:</span> <strong class="text-indigo-700"><%= order.payment_method %></strong></div>
      <% if (order.transaction_code) { %>
        <div>
          <span class="text-slate-500">Mã giao dịch:</span>
          <code class="px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 font-bold text-xs"><%= order.transaction_code %></code>
        </div>
      <% } %>
    </div>
  </div>
</div>

<% if (order.status !== 'COMPLETED' && order.status !== 'CANCELLED') { %>
<script>
  // Tự động kiểm tra cập nhật trạng thái từ Admin mỗi 5 giây
  const currentStatus = '<%= order.status %>';
  const currentPaymentStatus = '<%= order.payment_status || "UNPAID" %>';

  setInterval(async () => {
    try {
      const res = await fetch('/orders/<%= order.id %>/status', {
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) return;
      const data = await res.json();
      if (data.status !== currentStatus || data.payment_status !== currentPaymentStatus) {
        window.location.reload();
      }
    } catch (e) {}
  }, 5000);
</script>
<% } %>
