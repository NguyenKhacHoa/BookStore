<div class="max-w-lg mx-auto px-4 py-10">
  <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-extrabold text-slate-900">Tạo tài khoản mới</h1>
      <p class="text-sm text-slate-500 mt-1">Đăng ký để mua sắm và theo dõi đơn hàng dễ dàng</p>
    </div>

    <form action="/register" method="POST" class="space-y-4">
      <div>
        <label for="full_name" class="block text-sm font-semibold text-slate-700 mb-1.5">Họ và tên <span class="text-rose-500">*</span></label>
        <input
          id="full_name"
          type="text"
          name="full_name"
          required
          placeholder="Nguyễn Văn A"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-semibold text-slate-700 mb-1.5">Email <span class="text-rose-500">*</span></label>
        <input
          id="email"
          type="email"
          name="email"
          required
          placeholder="you@example.com"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="phone" class="block text-sm font-semibold text-slate-700 mb-1.5">Số điện thoại</label>
          <input
            id="phone"
            type="text"
            name="phone"
            placeholder="0901234567"
            class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>
        <div>
          <label for="address" class="block text-sm font-semibold text-slate-700 mb-1.5">Địa chỉ</label>
          <input
            id="address"
            type="text"
            name="address"
            placeholder="Quận 1, TP.HCM"
            class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="password" class="block text-sm font-semibold text-slate-700 mb-1.5">Mật khẩu <span class="text-rose-500">*</span></label>
          <input
            id="password"
            type="password"
            name="password"
            required
            minlength="6"
            placeholder="Ít nhất 6 ký tự"
            class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>
        <div>
          <label for="confirm_password" class="block text-sm font-semibold text-slate-700 mb-1.5">Xác nhận mật khẩu <span class="text-rose-500">*</span></label>
          <input
            id="confirm_password"
            type="password"
            name="confirm_password"
            required
            minlength="6"
            placeholder="Nhập lại mật khẩu"
            class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>
      </div>

      <button
        type="submit"
        class="w-full py-3 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 shadow-md transition"
      >
        Đăng ký tài khoản
      </button>
    </form>

    <p class="text-center text-sm text-slate-500 mt-6">
      Đã có tài khoản?
      <a href="/login" class="font-semibold text-indigo-600 hover:underline">Đăng nhập</a>
    </p>
  </div>
</div>
