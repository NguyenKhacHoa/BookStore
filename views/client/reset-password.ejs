<div class="max-w-md mx-auto px-4 py-12">
  <div class="bg-white border border-slate-200 rounded-3xl p-8 shadow-sm">
    <div class="text-center mb-6">
      <div class="w-12 h-12 mx-auto rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900">Đặt lại mật khẩu</h1>
      <p class="text-sm text-slate-500 mt-1">
        Nhập mã OTP đã gửi đến <strong class="text-slate-700"><%= resetEmail %></strong> và tạo mật khẩu mới.
      </p>
    </div>

    <form action="/reset-password" method="POST" class="space-y-4">
      <div>
        <label for="otp" class="block text-sm font-semibold text-slate-700 mb-1.5">Mã OTP (6 chữ số) <span class="text-rose-500">*</span></label>
        <input
          id="otp"
          type="text"
          name="otp"
          required
          maxlength="6"
          pattern="[0-9]{6}"
          placeholder="Nhập 6 chữ số OTP"
          class="w-full px-4 py-2.5 text-center text-lg font-extrabold tracking-[0.4em] border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div>
        <label for="new_password" class="block text-sm font-semibold text-slate-700 mb-1.5">Mật khẩu mới <span class="text-rose-500">*</span></label>
        <input
          id="new_password"
          type="password"
          name="new_password"
          required
          minlength="6"
          placeholder="Ít nhất 6 ký tự"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <div>
        <label for="confirm_password" class="block text-sm font-semibold text-slate-700 mb-1.5">Xác nhận mật khẩu mới <span class="text-rose-500">*</span></label>
        <input
          id="confirm_password"
          type="password"
          name="confirm_password"
          required
          minlength="6"
          placeholder="Nhập lại mật khẩu mới"
          class="w-full px-4 py-2.5 text-sm border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
        />
      </div>

      <button
        type="submit"
        class="w-full py-3 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 shadow-md transition"
      >
        Xác nhận đổi mật khẩu
      </button>
    </form>

    <div class="mt-6 flex items-center justify-between text-xs text-slate-500">
      <a href="/forgot-password" class="font-semibold text-indigo-600 hover:underline">Gửi lại mã OTP</a>
      <a href="/login" class="hover:underline">Quay lại đăng nhập</a>
    </div>
  </div>
</div>
