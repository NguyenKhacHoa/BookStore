<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Breadcrumb -->
  <nav class="text-xs text-slate-500 mb-6 flex items-center gap-2">
    <a href="/" class="hover:text-indigo-600">Trang chủ</a>
    <span>/</span>
    <a href="/books" class="hover:text-indigo-600">Tủ sách</a>
    <span>/</span>
    <span class="text-slate-800 font-medium truncate"><%= book.title %></span>
  </nav>

  <!-- Book Detail Card -->
  <div class="bg-white border border-slate-200 rounded-3xl p-6 sm:p-10 shadow-sm grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12">
    <div class="md:col-span-5 lg:col-span-4">
      <div class="rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 aspect-[3/4] shadow-md">
        <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="w-full h-full object-cover" />
      </div>
    </div>

    <div class="md:col-span-7 lg:col-span-8 flex flex-col">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <a
          href="/books?category=<%= book.category_slug %>"
          class="px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold hover:bg-indigo-100 transition"
        >
          <%= book.category_name %>
        </a>
        <% if (book.stock > 0) { %>
          <span class="px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">
            Còn hàng (<%= book.stock %> cuốn)
          </span>
        <% } else { %>
          <span class="px-3 py-1 rounded-full bg-rose-50 text-rose-700 text-xs font-semibold">
            Tạm hết hàng
          </span>
        <% } %>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 leading-tight"><%= book.title %></h1>
      <p class="text-sm text-slate-500 mt-2">
        Tác giả: <span class="font-semibold text-slate-800"><%= book.author %></span>
      </p>

      <div class="mt-6 pb-6 border-b border-slate-200">
        <div class="text-3xl font-extrabold text-indigo-600"><%= formatCurrency(book.price) %></div>
        <p class="text-xs text-slate-500 mt-1">Thanh toán khi nhận hàng (COD) &bull; Đổi trả miễn phí trong 7 ngày</p>
      </div>

      <div class="mt-6">
        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-wider mb-2">Giới thiệu nội dung</h2>
        <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
          <%= book.description || 'Chưa có mô tả chi tiết cho cuốn sách này.' %>
        </p>
      </div>

      <!-- Add to Cart Form -->
      <form action="/cart/add" method="POST" class="mt-8 pt-6 border-t border-slate-200 flex flex-wrap items-center gap-4">
        <input type="hidden" name="bookId" value="<%= book.id %>" />

        <div class="flex items-center gap-2">
          <label for="quantity" class="text-sm font-semibold text-slate-700">Số lượng:</label>
          <input
            id="quantity"
            type="number"
            name="quantity"
            value="1"
            min="1"
            max="<%= Math.max(1, book.stock) %>"
            <%= book.stock <= 0 ? 'disabled' : '' %>
            class="w-20 px-3 py-2.5 text-center text-sm font-bold border border-slate-300 rounded-xl focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none"
          />
        </div>

        <button
          type="submit"
          <%= book.stock <= 0 ? 'disabled' : '' %>
          class="flex-1 sm:flex-none px-8 py-3 rounded-xl bg-indigo-600 text-white font-bold text-sm hover:bg-indigo-700 disabled:bg-slate-300 disabled:cursor-not-allowed shadow-md transition"
        >
          <%= book.stock > 0 ? 'Thêm vào giỏ hàng' : 'Hết hàng' %>
        </button>

        <a href="/books" class="px-5 py-3 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition">
          Quay lại
        </a>
      </form>
    </div>
  </div>

  <!-- Related Books -->
  <% if (relatedBooks && relatedBooks.length > 0) { %>
    <section class="mt-14">
      <h2 class="text-xl font-bold text-slate-900 mb-6">Sách cùng thể loại</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <% relatedBooks.forEach((item) => { %>
          <a href="/books/<%= item.id %>" class="group bg-white rounded-2xl border border-slate-200 overflow-hidden hover:shadow-md transition flex flex-col">
            <div class="aspect-[3/4] bg-slate-100 overflow-hidden">
              <img src="<%= item.cover_image %>" alt="<%= item.title %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
            </div>
            <div class="p-4">
              <h3 class="font-bold text-slate-900 group-hover:text-indigo-600 transition line-clamp-2"><%= item.title %></h3>
              <p class="text-xs text-slate-500 mt-1"><%= item.author %></p>
              <div class="mt-2 font-extrabold text-indigo-600"><%= formatCurrency(item.price) %></div>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>
