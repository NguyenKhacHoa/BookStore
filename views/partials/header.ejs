<header class="sticky top-0 z-30 bg-white/90 backdrop-blur border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Brand -->
      <a href="/" class="flex items-center gap-2.5 shrink-0">
        <div class="w-9 h-9 rounded-xl bg-indigo-600 text-white flex items-center justify-center shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <div class="leading-tight">
          <span class="font-extrabold text-slate-900 text-lg tracking-tight">Bookstore</span>
          <span class="text-xs font-semibold text-indigo-600 block -mt-1">MVC EDITION</span>
        </div>
      </a>

      <!-- Search bar -->
      <form action="/books" method="GET" class="hidden md:flex flex-1 max-w-md">
        <div class="relative w-full">
          <input
            type="text"
            name="q"
            value="<%= typeof filters !== 'undefined' && filters.q ? filters.q : '' %>"
            placeholder="Tìm tên sách, tác giả..."
            class="w-full pl-10 pr-4 py-2 text-sm bg-slate-100 border border-transparent rounded-xl focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none transition"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
        </div>
      </form>

      <!-- Nav & Actions -->
      <div class="flex items-center gap-2 sm:gap-4">
        <nav class="hidden sm:flex items-center gap-1">
          <a href="/" class="px-3 py-2 rounded-lg text-sm font-medium <%= currentPath === '/' ? 'text-indigo-600 bg-indigo-50' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %> transition">
            Trang chủ
          </a>
          <a href="/books" class="px-3 py-2 rounded-lg text-sm font-medium <%= currentPath.startsWith('/books') ? 'text-indigo-600 bg-indigo-50' : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100' %> transition">
            Tủ sách
          </a>
        </nav>

        <!-- Cart -->
        <a href="/cart" class="relative p-2 rounded-xl text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 transition" title="Giỏ hàng">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          <% if (cartCount > 0) { %>
            <span class="absolute -top-0.5 -right-0.5 min-w-[20px] h-5 px-1 rounded-full bg-indigo-600 text-white text-[11px] font-bold flex items-center justify-center shadow">
              <%= cartCount %>
            </span>
          <% } %>
        </a>

        <!-- User Menu -->
        <% if (currentUser) { %>
          <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
            <a href="/orders" class="hidden lg:inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition">
              Đơn hàng
            </a>
            <% if (currentUser.role === 'admin') { %>
              <a href="/admin" class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold text-amber-800 bg-amber-100 hover:bg-amber-200 transition">
                Admin
              </a>
            <% } %>
            <span class="hidden md:inline text-sm font-semibold text-slate-700 max-w-[120px] truncate">
              <%= currentUser.full_name %>
            </span>
            <form action="/logout" method="POST" class="inline">
              <button type="submit" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-600 hover:bg-rose-50 transition">
                Đăng xuất
              </button>
            </form>
          </div>
        <% } else { %>
          <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
            <a href="/login" class="px-3 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:bg-slate-100 transition">
              Đăng nhập
            </a>
            <a href="/register" class="px-3.5 py-2 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition">
              Đăng ký
            </a>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Mobile Search -->
    <form action="/books" method="GET" class="pb-3 md:hidden">
      <input
        type="text"
        name="q"
        value="<%= typeof filters !== 'undefined' && filters.q ? filters.q : '' %>"
        placeholder="Tìm kiếm sách hoặc tác giả..."
        class="w-full px-4 py-2 text-sm bg-slate-100 rounded-xl focus:bg-white focus:ring-2 focus:ring-indigo-200 outline-none"
      />
    </form>
  </div>
</header>
