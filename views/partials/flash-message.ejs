<% if (flash && flash.message) { %>
  <div
    class="mb-5 rounded-xl px-4 py-3.5 text-sm font-medium flex items-center justify-between gap-3 border shadow-sm <%= flash.type === 'error' ? 'bg-rose-50 text-rose-800 border-rose-200' : 'bg-emerald-50 text-emerald-800 border-emerald-200' %>"
    role="alert"
  >
    <div class="flex items-center gap-2.5">
      <% if (flash.type === 'error') { %>
        <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% } else { %>
        <svg class="w-5 h-5 text-emerald-500 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      <% } %>
      <span><%= flash.message %></span>
    </div>
    <button
      type="button"
      onclick="this.parentElement.remove()"
      class="text-xs opacity-60 hover:opacity-100 font-bold px-1.5"
      aria-label="Đóng"
    >
      ✕
    </button>
  </div>
<% } %>
