# Server
PORT=3000
SESSION_SECRET=bookstore-mvc-secret-key

# Supabase PostgreSQL Connection String
# Lay tai: Supabase Dashboard -> Connect -> Session Pooler (hoac Direct Connection)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Bat SSL khi ket noi Supabase (mac dinh true)
DB_SSL=true
